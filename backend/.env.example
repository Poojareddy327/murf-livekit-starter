# =============================================================================
# Backend Environment Variables Template
# DO NOT COMMIT .env.local - USE THIS FILE AS TEMPLATE ONLY
# =============================================================================

# Copy this file to .env.local and fill in your actual values
# cp .env.example .env.local

# =============================================================================
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# =============================================================================
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# =============================================================================
# Linphone SIP Configuration (for outbound calls)
# =============================================================================
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your_sip_trunk_id
LINPHONE_SIP_URI=sip:your_username@sip.linphone.org
SIP_OUTBOUND_HOST=sip.linphone.org

# =============================================================================
# Telemetry
# =============================================================================
OTEL_SDK_DISABLED=true

# =============================================================================
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# =============================================================================
MURF_API_KEY=your_murf_api_key

# =============================================================================
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# =============================================================================
DEEPGRAM_API_KEY=your_deepgram_api_key

# =============================================================================
# LLM - use one of the following depending on which provider you use
# =============================================================================

# For Google Gemini (default)
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# For OpenAI (optional)
# Get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key
